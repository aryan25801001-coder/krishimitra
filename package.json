{
  "name": "krishi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"FRONTEND,ML_SERVICE\" -c \"green,blue\" \"next dev --webpack\" \"cd ml_service && python -m uvicorn app:app --reload --port 8000\"",
    "dev:frontend": "next dev --webpack",
    "dev:backend": "cd ml_service && python -m uvicorn app:app --reload --port 8000",
    "build": "prisma generate --schema=prisma/schema.prisma && next build --webpack",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "prisma": "5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
